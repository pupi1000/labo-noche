# Proveedor por defecto: mock | azure | ollama
MODEL_PROVIDER=mock

# Azure OpenAI / Microsoft Foundry - opcion recomendada con endpoint v1
AZURE_OPENAI_BASE_URL=https://<recurso>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Compatibilidad con AzureChatOpenAI clasico (si su recurso lo requiere)
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=

# Ollama local
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Limites pedagogicos
AGENT_MAX_STEPS=10
ENABLE_STUDENT_EXTENSION=false
